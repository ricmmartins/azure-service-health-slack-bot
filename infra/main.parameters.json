{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deployWorkload": {
      "value": "${SERVICE_HEALTH_DEPLOY_WORKLOAD}"
    },
    "appResourceExists": {
      "value": "${SERVICE_APP_RESOURCE_EXISTS}"
    },
    "baselineAlertEnabled": {
      "value": "${SERVICE_HEALTH_BASELINE_ALERT_ENABLED}"
    },
    "slackBotTokenSecretVersion": {
      "value": "${SERVICE_HEALTH_SECRET_VERSION}"
    },
    "operationsActionGroupId": {
      "value": "${SERVICE_HEALTH_OPERATIONS_ACTION_GROUP_ID}"
    },
    "serviceHealthRoutesJsonB64": {
      "value": "${SERVICE_HEALTH_ROUTES_JSON_B64}"
    },
    "secureWebhookClientId": {
      "value": "${SERVICE_HEALTH_API_CLIENT_ID}"
    },
    "secureWebhookObjectId": {
      "value": "${SERVICE_HEALTH_API_OBJECT_ID}"
    },
    "secureWebhookIdentifierUri": {
      "value": "${SERVICE_HEALTH_API_IDENTIFIER_URI}"
    },
    "tenantId": {
      "value": "${AZURE_TENANT_ID}"
    }
  }
}
